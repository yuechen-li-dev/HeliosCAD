// A rounded tray: the cavity is the exterior inset by the wall, open at the top.
Model RoundedTray {
  units: mm
  Profile outline = RoundedRect2 { center: [0mm, 0mm]; size: [120mm, 80mm]; radius: 12mm }
  Compose<Hollow> body {
    wallThickness: 2mm
    openings: [Top]
    Base stock { profile: outline; from: 0mm; to: 24mm; role: Stock }
  }

  // (120 × 80 − (4 − π) × 12²) × 24 less the 116 × 76 mm
  // cavity with 10 mm corners and a depth of 22 mm.
  Assert.Near Volume body { expected: 35369.84037mm^3; tolerance: 0.001mm^3 }
  Assert Topology body { shells: 1 }
}
